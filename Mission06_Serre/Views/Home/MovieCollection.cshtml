@model Movie

<h1 class="text-center my-4">Movie Collection Form</h1>

<form method="post" class="container card p-4 shadow-lg w-50">

    <input type="hidden" asp-for="MovieId" />

    <!-- Category input (Optional) -->
    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Select a Category</label>
        <select asp-for="CategoryId" class="form-select w-75">
            <option value="">-- No Category --</option>
            @foreach (Category c in ViewBag.Categories)
            {
                <option value="@c.CategoryId">@c.CategoryName</option>
            }
        </select>
    </div>

    <!-- Title input (Required) -->
    <div class="mb-3">
        <label asp-for="Title" class="form-label">Title</label>
        <input asp-for="Title" class="form-control w-75" required />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <!-- Year input (Required) -->
    <div class="mb-3">
        <label asp-for="Year" class="form-label">Year</label>
        <input asp-for="Year" type="number" class="form-control w-50" min="1888" required />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <!-- Optional: Director input -->
    <div class="mb-3">
        <label asp-for="Director" class="form-label">Director</label>
        <input asp-for="Director" class="form-control w-75" />
    </div>


    <!-- Optional: Rating dropdown -->
    <div class="mb-3">
        <label asp-for="Rating" class="form-label">Rating</label>
        <select asp-for="Rating" class="form-select w-75">
            <option value="">-- Select a Rating --</option>
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG-13">PG-13</option>
            <option value="R">R</option>
            <option value="NR">NR</option>
            <option value="UR">UR</option>
            <option value="TV-Y7">TV-Y7</option>
            <option value="TV-G">TV-G</option>
            <option value="TV-PG">TV-PG</option>
            <option value="TV-14">TV-14</option>
        </select>
    </div>

    <!-- Edited Radio Buttons (Required) -->
    <div class="mb-3">
        <label asp-for="Edited" class="form-label">Edited</label>
        <div class="form-check form-check-inline">
            <input asp-for="Edited" type="radio" class="form-check-input" value="true" id="editedYes" required />
            <label for="editedYes" class="form-check-label">Yes</label>
        </div>
        <div class="form-check form-check-inline">
            <input asp-for="Edited" type="radio" class="form-check-input" value="false" id="editedNo" required />
            <label for="editedNo" class="form-check-label">No</label>
        </div>
        <span asp-validation-for="Edited" class="text-danger"></span>
    </div>


    <!-- Optional: Lent To input -->
    <div class="mb-3">
        <label asp-for="LentTo" class="form-label">Lent To</label>
        <input asp-for="LentTo" class="form-control w-75" />
    </div>

    <!-- Copied to Plex Radio Buttons (Required) -->
    <div class="mb-3">
        <label asp-for="CopiedToPlex" class="form-label">Copied to Plex</label>
        <div class="form-check form-check-inline">
            <input asp-for="CopiedToPlex" type="radio" class="form-check-input" value="true" id="plexYes" required />
            <label for="plexYes" class="form-check-label">Yes</label>
        </div>
        <div class="form-check form-check-inline">
            <input asp-for="CopiedToPlex" type="radio" class="form-check-input" value="false" id="plexNo" required />
            <label for="plexNo" class="form-check-label">No</label>
        </div>
        <span asp-validation-for="CopiedToPlex" class="text-danger"></span>
    </div>



    <!-- Optional: Notes input (Max 25 characters) -->
    <div class="mb-3">
        <label asp-for="Notes" class="form-label">Notes (Max 25 characters)</label>
        <input asp-for="Notes" class="form-control w-75" maxlength="25" />
    </div>

    <!-- Submit button -->
    <button type="submit" class="btn btn-primary">Submit Movie Collection Form</button>

    <div asp-validation-summary="All"></div>
</form>
