@model Movie

<!-- This page serves as a confirmation screen after a user submits a movie.
It displays the details they entered and provides an option to add another movie. -->

<h1 class="text-center my-4">Movie Added Successfully!</h1>

<div class="container card p-4 shadow-lg w-50">
    <h3>Here’s what you entered:</h3>

    <ul class="list-group">
        <li class="list-group-item"><strong>Category:</strong> @(Model.Category != null ? Model.Category.CategoryName : "N/A")</li>
        <li class="list-group-item"><strong>Title:</strong> @Model.Title</li>
        <li class="list-group-item"><strong>Year:</strong> @Model.Year</li>
        <li class="list-group-item"><strong>Director:</strong> @(string.IsNullOrEmpty(Model.Director) ? "N/A" : Model.Director)</li>
        <li class="list-group-item"><strong>Rating:</strong> @(string.IsNullOrEmpty(Model.Rating) ? "N/A" : Model.Rating)</li>
        <li class="list-group-item"><strong>Edited:</strong> @(Model.Edited ? "Yes" : "No")</li>
        <li class="list-group-item"><strong>Copied to Plex:</strong> @(Model.CopiedToPlex ? "Yes" : "No")</li>
        <li class="list-group-item"><strong>Lent To:</strong> @(string.IsNullOrEmpty(Model.LentTo) ? "N/A" : Model.LentTo)</li>
        <li class="list-group-item"><strong>Notes:</strong> @(string.IsNullOrEmpty(Model.Notes) ? "N/A" : Model.Notes)</li>
    </ul>

    <a href="@Url.Action("MovieCollection")" class="btn btn-secondary mt-3">Add Another Movie</a>
</div>
